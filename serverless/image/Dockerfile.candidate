# LOCAL UNBUILT CANDIDATE; no publication or GPU authorization.
FROM docker.io/library/python@sha256:b701198cb708b68d9413ca67d6311bd97c9389a2c5fe4da0511fc652642366cd AS dependencies
COPY requirements.lock /requirements.lock
RUN python -m venv --without-pip /opt/venv && python -m pip --isolated --python /opt/venv install --no-cache-dir --only-binary=:all: --require-hashes --index-url https://pypi.org/simple -r /requirements.lock && python -m pip --python /opt/venv check
FROM docker.io/library/python@sha256:b701198cb708b68d9413ca67d6311bd97c9389a2c5fe4da0511fc652642366cd
RUN python -m pip --isolated uninstall -y pip setuptools wheel
COPY --from=dependencies /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
WORKDIR /qualification
COPY bootstrap.py handler.py runner.py ./
COPY package/ ./package/
ENTRYPOINT ["python", "-B", "/qualification/bootstrap.py"]
CMD []
# No admission, credentials, exposed ports or persistent storage.
