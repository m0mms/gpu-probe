# LOCAL UNBUILT CANDIDATE; publication and GPU execution not authorized.
FROM docker.io/library/python@sha256:e8c69d86735f6df3efa06b324694fe51f0422785f83a3bd463052636c2421944
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
WORKDIR /qualification
COPY requirements.lock ./requirements.lock
RUN python -m pip --isolated install --no-cache-dir --only-binary=:all: --require-hashes --index-url https://pypi.org/simple -r requirements.lock
COPY bootstrap.py handler.py runner.py ./
COPY package/ ./package/
ENTRYPOINT ["python", "-B", "/qualification/bootstrap.py"]
CMD []
# Deliberately no admission.json, keys, EXPOSE, SSH/Jupyter or startup services.
# NVRTC path (must verify in Linux): site-packages/nvidia/cuda_nvrtc/lib/libnvrtc.so.12
# Host driver injected by provider, not included in image. No stub driver allowed.
